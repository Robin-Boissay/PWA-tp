<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème principal de l'app : sans ActionBar, Compose dessine tout en Edge-to-Edge -->
    <style name="Theme.VoxWave.Main" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/voxwave_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Thème de lancement Splashscreen puis bascule sur Theme.VoxWave.Main -->
    <style name="Theme.VoxWave" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/voxwave_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/voxwave_primary</item>
        <item name="postSplashScreenTheme">@style/Theme.VoxWave.Main</item>
    </style>
</resources>
