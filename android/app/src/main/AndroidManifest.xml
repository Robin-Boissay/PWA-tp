<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissions normales : accordées à l'installation -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Pas de publicité : retrait explicite de l'identifiant publicitaire (Annexe 4) -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Permissions runtime (demandées à l'utilisateur) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".VoxWaveApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxWave">

        <!-- Annexe 4 : Rien ne part avant le consentement explicite de l'utilisateur -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <!-- Suivi d'écran géré manuellement avec Compose (évite MainActivity automatique) -->
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <!-- Activité principale (SingleTop) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VoxWave">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Cible de partage (Intent-filter SEND) : texte ou fichier audio partagé depuis une autre app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- App Link : l'URL web de la PWA ouvre VoxWave en natif (TD A3) -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="${pwaHost}" />
            </intent-filter>
        </activity>

        <!-- Service de premier plan (Foreground Service) : enregistrement audio en arrière-plan -->
        <service
            android:name=".service.AudioForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- FileProvider pour le partage sécurisé de fichiers audio enregistrés -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
